# Aryan Electronics - Global Environment Configuration Reference
# Duplicate this file as .env for development mode

# ==========================================
# 1. SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==========================================
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local)
# ==========================================
# Local development fallback:
MONGODB_URI=mongodb://127.0.0.1:27017/aryan_electronics
# Production Atlas connection pattern:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aryan_electronics?retryWrites=true&w=majority

# ==========================================
# 3. AUTHENTICATION & SECURITY
# ==========================================
# Cryptographic secret for signing JWTs (must be minimum 32 characters in production)
JWT_SECRET=aryan_electronics_dev_secret_replace_in_production_environment_2026
JWT_EXPIRES_IN=30d

# ==========================================
# 4. EXTERNAL PROVIDERS & AGGREGATION
# ==========================================
# eBay Finding API (Optional - mock fixtures active if omitted)
# EBAY_APP_ID=your_ebay_app_id_here
# EBAY_GLOBAL_ID=EBAY-US

# ==========================================
# 5. FRONTEND CONFIGURATION (Client App)
# ==========================================
REACT_APP_API_URL=/api
