# Aryan Electronics - Backend Server Environment Configuration
# Copy to .env and configure for your environment

# Server Runtime Settings
PORT=5000
NODE_ENV=development

# MongoDB Connection
# In production, use MongoDB Atlas replica set URI with TLS enabled
MONGODB_URI=mongodb://127.0.0.1:27017/aryan_electronics

# Client Allowed Origin (CORS whitelist)
CLIENT_URL=http://localhost:3000

# Authentication & JWT Configuration
# Use a 64+ char cryptographically random secret in production
JWT_SECRET=super_secure_aryan_electronics_jwt_secret_dev_mode_change_in_production
JWT_EXPIRES_IN=30d

# External Product Providers (Optional)
# EBAY_APP_ID=your_ebay_production_app_id
# EBAY_GLOBAL_ID=EBAY-US
# EBAY_CAMP_ID=your_campaign_id

# Observability & Analytics Settings
ANALYTICS_BUFFER_SIZE=2000
