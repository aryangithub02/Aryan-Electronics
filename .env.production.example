# ==============================================================================
# ARYAN ELECTRONICS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this template to your production secret manager (e.g. AWS Secrets Manager,
#    Doppler, Railway, Render, or systemd environment file).
# 2. Never check in actual production credentials or production .env files to Git.
# ==============================================================================

# Node Runtime
NODE_ENV=production
PORT=5000

# CORS Whitelist (Set to your custom domain, e.g., https://aryanelectronics.com)
CLIENT_URL=https://aryanelectronics.com

# MongoDB Atlas Production Replica Set (TLS 1.3 enforced)
# Note: Ensure IP access list in Atlas includes your production container/server IPs.
MONGODB_URI=mongodb+srv://prod_app_user:<SECURE_CLUSTER_PASSWORD>@aryan-prod.mongodb.net/aryan_electronics?retryWrites=true&w=majority&appName=AryanProdCluster

# JSON Web Token Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64_BYTE_RANDOM_HEX_STRING_FOR_PRODUCTION_JWT>
JWT_EXPIRES_IN=7d

# Production Rate Limiting (Handled by express-rate-limit + reverse proxy)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# External Aggregator API Credentials
# EBAY_APP_ID=<YOUR_PRODUCTION_EBAY_APP_ID>
# EBAY_GLOBAL_ID=EBAY-US

# Client Production Environment Variables (Used during npm run build)
REACT_APP_API_URL=https://api.aryanelectronics.com/api
